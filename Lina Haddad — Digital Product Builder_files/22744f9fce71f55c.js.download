        html { overflow-y: auto !important; margin: 0 !important; padding: 0 !important; }
        body { background: hsl(0, 0%, 7%) !important; overflow-x: hidden; height: auto !important; margin: 0 !important; padding: 0 !important; }

        .vc-root {
          --vc-bg-onyx: linear-gradient(to bottom right, hsl(240, 1%, 25%) 3%, hsl(0, 0%, 19%) 97%);
          --vc-bg-jet: linear-gradient(to bottom right, hsla(240, 1%, 18%, 0.251) 0%, hsla(240, 2%, 11%, 0) 100%), hsl(240, 2%, 13%);
          --vc-bg-yellow-1: linear-gradient(to bottom right, hsl(45, 100%, 71%) 0%, hsla(36, 100%, 69%, 0) 50%);
          --vc-bg-yellow-2: linear-gradient(135deg, hsla(45, 100%, 71%, 0.251) 0%, hsla(35, 100%, 68%, 0) 59.86%), hsl(240, 2%, 13%);
          --vc-border-onyx: linear-gradient(to bottom right, hsl(0, 0%, 25%) 0%, hsla(0, 0%, 25%, 0) 50%);
          --vc-grad-yellow: linear-gradient(to right, hsl(45, 100%, 72%), hsl(35, 100%, 68%));
          --vc-shadow-1: -4px 8px 24px hsla(0, 0%, 0%, 0.25);
          --vc-shadow-2: 0 16px 30px hsla(0, 0%, 0%, 0.25);
          --vc-shadow-3: 0 16px 40px hsla(0, 0%, 0%, 0.25);
          --vc-shadow-5: 0 24px 80px hsla(0, 0%, 0%, 0.25);
        }

        @media (min-width: 1024px) {
          .vc-root {
            --vc-shadow-1: -4px 8px 24px hsla(0, 0%, 0%, 0.125);
            --vc-shadow-2: 0 16px 30px hsla(0, 0%, 0%, 0.125);
            --vc-shadow-3: 0 16px 40px hsla(0, 0%, 0%, 0.125);
          }
          .vc-nav {
            position: absolute;
            bottom: auto;
            top: 0;
            inset-inline-start: auto;
            inset-inline-end: 0;
            width: max-content;
            border-radius: 0 20px;
            padding: 0 20px;
            box-shadow: none;
          }
          .vc-nav ul { gap: 30px; padding: 0 20px; }
          .vc-nav button { font-weight: 500; }
        }

        @media (min-width: 1250px) {
          .vc-sidebar-col {
            flex: 0 0 280px;
          }
          .vc-sidebar {
            position: fixed;
            top: 40px;
            width: 280px;
            max-height: max-content;
            margin-bottom: 0;
            overflow: visible;
            z-index: 1;
          }
        }

        .vc-root ::selection { background: hsl(45, 100%, 72%); color: hsl(0, 0%, 7%); }
        .vc-root :focus-visible { outline: 2px solid hsl(45, 100%, 72%); outline-offset: 2px; }

        @keyframes vcFade { 0% { opacity: 0; } 100% { opacity: 1; } }
        @keyframes vcPing { 75%, 100% { transform: scale(2); opacity: 0; } }
        @keyframes vcScaleUp { 0% { transform: scale(0.5); } 100% { transform: scale(1); } }
        @keyframes vcModalIn { 0% { transform: scale(0.9); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

        .vc-root ::-webkit-scrollbar { width: 5px; height: 5px; }
        .vc-root ::-webkit-scrollbar-track { background: hsl(240, 1%, 17%); border-radius: 5px; }
        .vc-root ::-webkit-scrollbar-thumb { background: hsl(45, 100%, 72%); border-radius: 5px; }
        .vc-modal-scr::-webkit-scrollbar { width: 4px; }
        .vc-modal-scr::-webkit-scrollbar-track { background: transparent; }
        .vc-modal-scr::-webkit-scrollbar-thumb { background: hsl(0, 0%, 22%); border-radius: 4px; }

        .vc-root .fixed.bottom-6.right-6 { bottom: 70px !important; }
        @media (min-width: 580px) { .vc-root .fixed.bottom-6.right-6 { bottom: 80px !important; } }
        @media (min-width: 1024px) { .vc-root .fixed.bottom-6.right-6 { bottom: 24px !important; } }

        @media (min-width: 1250px) {
          body::-webkit-scrollbar { width: 20px; }
          body::-webkit-scrollbar-track { background: hsl(0, 0%, 7%); }
          body::-webkit-scrollbar-thumb { border: 5px solid hsl(0, 0%, 7%); background: hsla(0, 0%, 100%, 0.1); border-radius: 20px; box-shadow: inset 1px 1px 0 hsla(0, 0%, 100%, 0.11), inset -1px -1px 0 hsla(0, 0%, 100%, 0.11); }
          body::-webkit-scrollbar-thumb:hover { background: hsla(0, 0%, 100%, 0.15); }
          body::-webkit-scrollbar-button { height: 60px; }
        }
      `})]})}e.s(["default",()=>O])},599543,e=>{"use strict";var t=e.i(843476),r=e.i(271645),i=e.i(846932),n=e.i(778917),a=e.i(350682),s=e.i(551348),o=e.i(263488),l=e.i(343432),c=e.i(221663),h=e.i(956850),d=e.i(994964);class u extends d.Geometry{constructor(e,{attributes:t={}}={}){Object.assign(t,{position:{size:2,data:new Float32Array([-1,-1,3,-1,-1,3])},uv:{size:2,data:new Float32Array([0,0,2,0,0,2])}}),super(e,t)}}var m=e.i(80075);let p=e=>{let t=/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(e);return t?[parseInt(t[1],16)/255,parseInt(t[2],16)/255,parseInt(t[3],16)/255]:[1,1,1]},f=(e,t,r)=>{switch(e){case"top-left":return{anchor:[0,-.2*r],dir:[0,1]};case"top-right":return{anchor:[t,-.2*r],dir:[0,1]};case"left":return{anchor:[-.2*t,.5*r],dir:[1,0]};case"right":return{anchor:[1.2*t,.5*r],dir:[-1,0]};case"bottom-left":return{anchor:[0,1.2*r],dir:[0,-1]};case"bottom-center":return{anchor:[.5*t,1.2*r],dir:[0,-1]};case"bottom-right":return{anchor:[t,1.2*r],dir:[0,-1]};default:return{anchor:[.5*t,-.2*r],dir:[0,1]}}},g=({raysOrigin:e="top-center",raysColor:i="#ffffff",raysSpeed:n=1,lightSpread:a=1,rayLength:s=2,pulsating:o=!1,fadeDistance:l=1,saturation:d=1,followMouse:g=!0,mouseInfluence:x=.1,noiseAmount:b=0,distortion:v=0,className:y=""})=>{let w=(0,r.useRef)(null),j=(0,r.useRef)(null),N=(0,r.useRef)(null),S=(0,r.useRef)({x:.5,y:.5}),k=(0,r.useRef)({x:.5,y:.5}),z=(0,r.useRef)(null),C=(0,r.useRef)(null),M=(0,r.useRef)(null),[E,A]=(0,r.useState)(!1),L=(0,r.useRef)(null);return(0,r.useEffect)(()=>{if(w.current)return L.current=new IntersectionObserver(e=>{A(e[0].isIntersecting)},{threshold:.1}),L.current.observe(w.current),()=>{L.current&&(L.current.disconnect(),L.current=null)}},[]),(0,r.useEffect)(()=>{if(E&&w.current)return M.current&&(M.current(),M.current=null),(async()=>{if(!w.current||(await new Promise(e=>setTimeout(e,10)),!w.current))return;let t=new c.Renderer({dpr:Math.min(window.devicePixelRatio,2),alpha:!0});N.current=t;let r=t.gl;for(r.canvas.style.width=