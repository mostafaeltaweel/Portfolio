        /* Social link buttons — mobile-friendly with active states */
        .iw-social-btn {
          width: 2.5rem;
          height: 2.5rem;
          border-radius: 0.75rem;
          background: #f9fafb;
          border: 1px solid #e5e7eb;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #6b7280;
          transition: all 0.2s ease;
          -webkit-tap-highlight-color: transparent;
        }
        .iw-social-btn--lg {
          width: 2.75rem;
          height: 2.75rem;
        }
        .iw-social-btn:active {
          background: #eef2ff;
          border-color: #c7d2fe;
          color: #4f46e5;
          transform: scale(0.92);
        }
        @media (hover: hover) {
          .iw-social-btn:hover {
            background: #4f46e5;
            border-color: #4f46e5;
            color: #fff;
            transform: scale(1.1);
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
          }
        }

        /* Skill icons — colorized on mobile, grayscale on desktop with hover */
        .iw-skill-icon {
          transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
          -webkit-tap-highlight-color: transparent;
        }
        @media (hover: hover) {
          .iw-skill-icon {
            filter: grayscale(100%);
            opacity: 0.7;
          }
          .iw-skill-icon:hover {
            filter: grayscale(0%);
            opacity: 1;
            transform: scale(1.1);
          }
        }

        /* Smooth scrolling */
        html {
          scroll-behavior: smooth;
        }

        /* Line clamp for project descriptions */
        .line-clamp-1 {
          display: -webkit-box;
          -webkit-line-clamp: 1;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }
