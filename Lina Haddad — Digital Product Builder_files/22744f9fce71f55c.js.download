        .light-rays-container {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          pointer-events: none;
        }
        .mq-skills {
          display: flex;
          gap: 2rem;
        }
        .mq-skills-track {
          display: flex;
          gap: 2rem;
          flex-shrink: 0;
          animation: mq-scroll 30s linear infinite;
        }
        .mq-skills:hover .mq-skills-track {
          animation-play-state: paused;
        }
        .mq-skill-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          user-select: none;
          padding: 2rem 0;
          width: 6rem;
          flex-shrink: 0;
        }
        .mq-skill-item:hover svg {
          color: #fff;
        }
        .mq-skill-item:hover span {
          color: #fff;
        }
        @keyframes mq-scroll {
          from { transform: translateX(0); }
          to { transform: translateX(calc(-100% - 2rem)); }
        }
